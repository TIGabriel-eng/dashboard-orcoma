# Credenciais do WhatsApp Cloud API (Meta)
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).

# Access Token gerado no Meta for Developers (WhatsApp Business)
WHATSAPP_TOKEN=

# ID do número remetente (Phone Number ID) no Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=

# Nome do template aprovado no painel do WhatsApp (ex.: novo_lead)
WHATSAPP_TEMPLATE_NAME=

# Destino dos leads: número do Gilton Comercial, somente dígitos (formato internacional)
WHATSAPP_TO=557399747460

# Google reCAPTCHA v2 (checkbox) - "Trabalhe Conosco"
# Chaves geradas em https://www.google.com/recaptcha/admin (tipo: reCAPTCHA v2, "Não sou um robô")
# Site key é pública (usada no frontend); Secret key fica somente no backend.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ===========================================================================
# E-mail (alertas de segurança)
# ===========================================================================
# Deixe EMAIL_HOST em branco enquanto não tiver SMTP: os alertas serão
# apenas registrados nos logs e ficam visíveis no painel administrativo.
# Exemplo com Gmail/Google Workspace:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=seuemail@gmail.com
#   EMAIL_HOST_PASSWORD=sua-senha-de-app
#   EMAIL_USE_TLS=true
#   ALERT_EMAIL_TO=voce@orcoma.com.br
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@orcoma.com.br
ALERT_EMAIL_TO=

# URL pública do site (usada nos links dos e-mails de alerta)
SITE_URL=http://127.0.0.1:8000
